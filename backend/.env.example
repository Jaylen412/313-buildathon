# Copy to .env and fill in. Real secrets never get committed (.env is gitignored).
# See md/TODO.md section A for what each of these is and why.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Stretch only (Census ACS join) — see md/TODO.md.
CENSUS_API_KEY=

# Shared secret standing in for "organization accounts" (see md/architecture.md
# §6). Generate with: openssl rand -hex 24
# Must match VITE_ORG_TOKEN in frontend/.env.local.
SIGNALS_ORG_TOKEN=

# 1 = anonymize household output (demo mode). 0 = full detail.
SIGNALS_DEMO=1

# block_group (default) | block
GEO_LEVEL=block_group

# auto (default) | trained | fallback
MODEL_MODE=auto
